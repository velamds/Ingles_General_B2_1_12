0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"id": 1, "correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}]}], "stimuli_ids": [], "id": 10, "template_override": 1}, {"type": "DWS", "_data": [{"type": "instructions", "contents": [{"content": " \nRecount  story about a camping trip.\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n", "type": "text"}]}], "questions": [{"responses": [{"id": 0, "correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"content": "engenn9le12ob05re7pdf01.pdf", "type": "pdf"}]}]}], "stimuli_ids": [], "id": 11, "template_override": 1}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "stimuli": [{"id": 0, "template_override": 1, "_data": [], "type": "welcome", "contents": [{}]}, {"_data": [], "type": "audio", "id": 1, "template_override": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "image": "engenn9le12ob05re2img01.jpg", "time": "0", "id": 0}, {"text": "My friends and I have always enjoyed camping. We've gone every year since we've been old enough to be out on our own. I have always prided myself as being the consummate camper. Last week, I wasn't.<br/><br/>We decided to hit the woods early Saturday morning. We packed our sleeping bags and made sure the batteries in the flashlights worked. Just as we were leaving, my mom appeared and reminded me to take a warm sweater. I was feeling a bit embarrassed in front of the guys, so I passed it off. The sun was shining and it was promising to be another hot sticky day.", "image": "engenn9le12ob05re2img01.jpg", "time": "", "id": 1}, {"text": "She looked down at the shoes I was wearing and asked if they were the only pair of shoes I was taking. I've often packed extras, but again the sun said no. When I haven't seen a cloud all day, the extra weight makes no sense! I just laughed it off.", "image": "engenn9le12ob05re2img02.jpg", "time": "", "id": 2}, {"text": "That night at the campsite after dinner, it clouded over. A chill wind started up. Thunder was crashing. Lightning flashed across the sky. Within a few minutes it was raining cats and dogs. I was cold, wet, and my shoes were completely soaked through.<br/><br/>My friends and I were complaining. We were wishing we had raingear. The next day we all came down with colds. Mom has never been one to say \u2018I told you so'. I knew I had just been stubborn and was paying for it.", "image": "engenn9le12ob05re2img03.jpg", "time": "", "id": 3}], "coverimg": "engenn9le12ob05re2img01.jpg", "audiosrc": "engenn9le12ob05re2aud01"}, "type": "slideshow"}]}, {"type": "video", "_data": [], "title": "", "template_override": 1, "id": 2, "contents": [{"value": {"video_src": "engenn9le12ob05re2vid01", "images": [{"text": "", "image": "", "time": "0", "id": 0}, {"text": "My friends and I have always enjoyed camping. We've gone every year since we've been old enough to be out on our own. I have always prided myself as being the consummate camper. Last week, I wasn't. We decided to hit the woods early Saturday morning. We packed our sleeping bags and made sure the batteries in the flashlights worked. Just as we were leaving, my mom appeared and reminded me to take a warm sweater. I was feeling a bit embarrassed in front of the guys, so I passed it off. The sun was shining and it was promising to be another hot sticky day.", "image": "", "time": "100", "id": 1}, {"text": "She looked down at the shoes I was wearing and asked if they were the only pair of shoes I was taking. I've often packed extras, but again the sun said no. When I haven't seen a cloud all day, the extra weight makes no sense! I just laughed it off.", "image": "", "time": "33000", "id": 2}, {"text": "That night at the campsite after dinner, it clouded over. A chill wind started up. Thunder was crashing. Lightning flashed across the sky. Within a few minutes it was raining cats and dogs. I was cold, wet, and my shoes were completely soaked through. My friends and I were complaining. We were wishing we had rain gear. The next day we all came down with colds. Mom has never been one to say \u2018I told you so'. I knew I had just been stubborn and was paying for it.", "image": "", "time": "47700", "id": 3}]}, "type": "video"}]}]}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"content": "Anecdotes and Personal Stories", "type": "lesson_name"}, {"content": "Mother Knows Best", "type": "unit_name"}, {"content": 5, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 12, "type": "lesson"}, {"content": "B2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": " Describe situations in written and spoken interactions according to social contexts.", "type": "primary"}, {"content": "Understands specific information in written texts about the different social and work contexts. ", "type": "secondary_1"}, {"content": "Understands specific information in written texts about the different social and work contexts. ", "type": "secondary_2"}, {"content": "Understands specific information in written texts about the different social and work contexts. ", "type": "secondary_3"}, {"content": "Understands specific information in written texts about the different social and work contexts. ", "type": "secondary_4"}, {"content": "Understands specific information in written texts about the different social and work contexts. ", "type": "secondary_5"}, {"content": "Understands specific information in written texts about the different social and work contexts. ", "type": "secondary_6"}, {"content": "Understands specific information in written texts about the different social and work contexts. ", "type": "secondary_7"}, {"content": "Understands specific information in written texts about the different social and work contexts. ", "type": "secondary_8"}]}, {"content": "engenn9le12ob05re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "The Present Perfect Tense vs. The Simple Past Tense", "type": "heading"}, {"content": "You use the Present Perfect tense to talk about a past action or an action that began in the past that is connected to the present in some way. <br/><br/>You use the Simple Past tense to talk about many kinds of past events: short, quickly finished actions, longer situations and repeated events. ", "type": "describer"}, {"content": "You can use the <span class=\"underline\">Present Perfect tense</span> to talk about experience.<br/>When you use the Present Perfect tense, you think about the past and present together. There is some connection between what happened in the past and now.<br/><br/>For example: <br/><br/><span class=\"italic\">I have learned English.</span> = I learned English in the past and now I can speak English.<br/><span class=\"italic\">My friends and I have always enjoyed camping. </span>= We enjoyed camping in the past and we still enjoy it now.<br/><br/>It is common to use <span class=\"italic\">for</span> and <span class=\"italic\">since</span> when referring to time periods in the Present Perfect:<br/><br/><ul><li>You use FOR to talk about how long an action has been happening (a week, 2 days, five hours, six years etc.)</li><li>You use SINCE to talk about when the action started (2010, Monday, she was a child)</li></ul><br/><span class=\"italic\">We've gone every year <span class=\"strong\">since</span> we've been old enough to be out on our own. </span><br/><br/>Usually, when you use the <span class=\"underline\">Simple Past tense</span>, the time of the finished action is clear from the context or explicitly mentioned in the sentence.<br/><br/>For example:<br/><br/><span class=\"italic\"><span class=\"strong\">Yesterday</span>, I went to the store.</span><br/><br/>It is clear when the action occurred. In this sentence we would not use the Present Perfect. (<span style=\"text-decoration:line-through;\">Yesterday, I have been to the store).", "type": "text"}, {"content": "My friends and I have always enjoyed camping. ", "type": "example"}, {"content": "We've gone every year since we've been old enough to be out on our own. ", "type": "example"}, {"content": "I have always prided myself as being the consummate camper.", "type": "example"}, {"content": " Mom has never been one to say \u2018I told you so'.", "type": "example"}, {"content": "We decided to hit the woods early Saturday morning. ", "type": "example"}, {"content": "We packed our sleeping bags and made sure the batteries in the flashlights worked. ", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "The Past Continuous Tense vs. The Simple Past Tense", "type": "heading"}, {"content": "You use the Past Continuous tense to talk about an action that was happening at a time before now. <br/><br/>You use the Simple Past tense to talk about many kinds of past events: short, quickly finished actions, longer situations and repeated events.", "type": "describer"}, {"content": "You can use the Past Continuous to describe the background in a story written in the past tense.", "type": "text"}, {"content": "For example: ", "type": "text"}, {"content": "<span class=\"italic\">The sun <span class=\"strong\">was shining</span> and it <span class=\"strong\">was promising</span> to be another hot sticky day. </span>", "type": "text"}, {"content": "You often use the Simple Past and the Past Continuous together. You can use the Past Continuous to to describe an action that was interrupted by another event or action (Simple Past).", "type": "text"}, {"content": "For example:", "type": "text"}, {"content": "<span class=\"italic\">Just as <span class=\"strong\">we were leaving</span>, my mom <span class=\"strong\">appeared</span> and <span class=\"strong\">reminded</span> me to take a warm sweater. </span>", "type": "text"}, {"content": "The form of the Past Continuous is:", "type": "text"}, {"content": "Subject + <span class=\"italic\">was/were</span> + verb-<span class=\"italic\">ing</span>", "type": "text"}, {"content": "We decided to hit the woods early Saturday morning. ", "type": "example"}, {"content": "We packed our sleeping bags and made sure the batteries in the flashlights worked. ", "type": "example"}, {"content": "Just as we were leaving, my mom appeared and reminded me to take a warm sweater. ", "type": "example"}, {"content": "I was feeling a bit embarrassed in front of the guys, so I passed it off. ", "type": "example"}, {"content": "The sun was shining and it was promising to be another hot sticky day. ", "type": "example"}, {"content": "She looked down at the shoes I was wearing and asked if they were the only pair of shoes I was taking. ", "type": "example"}, {"content": "My friends and I were complaining. ", "type": "example"}, {"content": "We were wishing we had raingear. ", "type": "example"}, {"content": "The next day we all came down with colds. ", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "to pride", "type": "name"}, {"content": "to place value on a skill or good quality one has", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I have always prided myself as being the perfect camper.", "type": "example"}, {"content": "engenn9le12ob05aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use to talk about camping.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "consummate", "type": "name"}, {"content": "extremely skilled; perfect", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I am the consummate camper.", "type": "example"}, {"content": "engenn9le12ob05aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "flashlight", "type": "name"}, {"content": "a small electric lamp that uses batteries and that you can hold in your hand", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We made sure the batteries in the flashlights worked.", "type": "example"}, {"content": "engenn9le12ob05aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "sticky", "type": "name"}, {"content": "warm, wet weather", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: It was promising to be another hot sticky day. ", "type": "example"}, {"content": "engenn9le12ob05aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to start up", "type": "name"}, {"content": "the act of activating, turning on, or setting in motion", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: A chill wind started up.", "type": "example"}, {"content": "engenn9le12ob05aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "thunder", "type": "name"}, {"content": "the sudden loud noise which comes after a flash of lightning", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The thunder was crashing.", "type": "example"}, {"content": "engenn9le12ob05aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "lightning", "type": "name"}, {"content": "a flash, or several flashes, of very bright light in the sky caused by electricity", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Lightning flashed across the sky.", "type": "example"}, {"content": "engenn9le12ob05aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "raining cats and dogs", "type": "name"}, {"content": "raining very heavily", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Within a few minutes it was raining cats and dogs.", "type": "example"}, {"content": "engenn9le12ob05aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "soaked through", "type": "name"}, {"content": "extremely wet in every part", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: My shoes were completely soaked through.", "type": "example"}, {"content": "engenn9le12ob05aud09", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Brainstorm ideas about think that could happen on a camping trip.", "type": "text"}, {"content": "Put your ideas on a timeline then add vocabulary for feelings and reactions. ", "type": "text"}, {"content": "Write out the story talking about things that happened or were happening in the past.", "type": "text"}, {"content": "Read your finished story to a partner.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I brainstorm ideas  for a camping trip story.", "type": "text"}, {"content": "I put the story on a timeline and add vocabulary.", "type": "text"}, {"content": "I use the Past Simple and Past Continuous tenses to tell the story.", "type": "text"}, {"content": "I share my story with a partner.", "type": "text"}]}]}