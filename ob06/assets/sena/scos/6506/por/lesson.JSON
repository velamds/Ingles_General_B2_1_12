_data": [{"type": "text", "content": ""}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"type": "text", "content": "I would have broken up with her."}], "selected": 0, "id": 1}], "id": 2, "_data": [{"type": "question", "contents": [{"type": "text", "content": "If she canceled the trip,"}]}, {"type": "objective", "content": "secondary_8"}]}], "template_override": 1, "id": 9, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " \nComplete the sentences.\n"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "post_instructions", "contents": [{"type": "text", "content": "\nInstructions: Move the words up or down <span class=\"sena-icon sena-icon-vertical-drag\"></span> to complete each sentence.\n"}]}]}, {"stimuli_ids": [], "type": "RSLT", "questions": [{"responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 1}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "text", "content": ""}]}]}], "template_override": 1, "id": 10, "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}, {"stimuli_ids": [], "type": "DWS", "questions": [{"responses": [{"correct": 1, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "pdf", "content": "engenn9le12ob06re7pdf01.pdf"}]}]}], "template_override": 1, "id": 11, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " \nTalk about annoying siblings.\n"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Speaking"}, {"type": "skill", "content": "Writing"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n"}]}]}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn9le12ob06re2img01.jpg", "audiosrc": "engenn9le12ob06re2aud01", "images": [{"time": "0", "image": "engenn9le12ob06re2img01.jpg", "text": "", "id": 0}, {"time": "100", "image": "engenn9le12ob06re2img01.jpg", "text": "You might have dealt with a younger sister. If you did, you may have had an experience similar to the one I had. My sister could have tried anyone's patience at times. Tara loved to play the \"What would you have done if ... \" game.<br/><br/>She must have asked me a million questions over the years. One of her favorite questions was, \"If you had won a million dollars last year, where would you have gone?\"", "id": 1}, {"time": "26000", "image": "engenn9le12ob06re2img02.jpg", "text": "Another she loved to ask is, \"What would you have done if the president had asked you to go to the moon? What would you have taken with you?\" At least once a week she asked me, \"If you could have gotten anything for your birthday, what would you have asked for?\"", "id": 2}, {"time": "42000", "image": "engenn9le12ob06re2img03.jpg", "text": "Every once in a while, she came up with a startling question like, \"If the president had asked you for advice, what would you have said to him? If a thief had held you up, would you have given him your money?\"<br/><br/>I thought I must have heard them all over the years. However, to my astonishment she looked sheepishly down at the table one night and whispered apprehensively, \"What would you have done if you had found out your little sister had broken your laptop?\" I was speechless.", "id": 3}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Anecdotes and Personal Stories"}, {"type": "unit_name", "content": "What Would You Do If"}, {"type": "position", "content": 6}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 12}, {"type": "level", "content": "B2.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": " Describe situations in written and spoken interactions according to social contexts."}, {"type": "secondary_1", "content": "Understands specific information in written texts about the different social and work contexts. "}, {"type": "secondary_2", "content": "Understands specific information in written texts about the different social and work contexts. "}, {"type": "secondary_3", "content": "Understands specific information in written texts about the different social and work contexts. "}, {"type": "secondary_4", "content": "Understands specific information in written texts about the different social and work contexts. "}, {"type": "secondary_5", "content": "Understands specific information in written texts about the different social and work contexts. "}, {"type": "secondary_6", "content": "Understands specific information in written texts about the different social and work contexts. "}, {"type": "secondary_7", "content": "Understands specific information in written texts about the different social and work contexts. "}, {"type": "secondary_8", "content": "Understands specific information in written texts about the different social and work contexts. "}]}, {"type": "background_image", "content": "engenn9le12ob06re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "The Third Conditional - Talking Hypothetically About the Past"}, {"type": "describer", "content": "You use third conditional to talk about unreal situations in the past.<br/>These are things that did not happen in the past. You often use the third conditional to speculate about the past."}, {"type": "text", "content": "When you want to talk about situations in the past in a hypothetical context (not real or necessarily true), you can use the structure <span class=\"italic\">would have</span> + past participle."}, {"type": "text", "content": "<span class=\"italic\">If you <span class=\"strong\">had won</span> a million dollars last year, where <span class=\"strong\">would you have</span> gone?</span>"}, {"type": "text", "content": "Look at the chart below for the structure of the third conditional:"}, {"type": "table", "content": "{\"rows\":2,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Conditional Name\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Structure\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Third\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" <span class=\\\"italic\\\">If</span> + Past Perfect, <span class=\\\"italic\\\">would have</span> + past participle\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> If a thief <span class=\\\"strong\\\">had held</span> you up,<span class=\\\"strong\\\"> would</span> you <span class=\\\"strong\\\">have given</span> him your money?</span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "example", "content": "What would you have done if the president had asked you to go to the moon? What would you have taken with you?\" "}, {"type": "example", "content": "At least once a week she asked me, \"If you could have gotten anything for your birthday, what would you have asked for?\""}, {"type": "example", "content": " \"If you had won a million dollars last year, where would you have gone?\""}, {"type": "example", "content": "\"If the president had asked you for advice, what would you have said to him?\" "}, {"type": "example", "content": "Once she asked me, \"If a thief had held you up, would you have given him your money?\u201d"}, {"type": "example", "content": "What would you have done if you had found out your little sister had broken your laptop?"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Speculating About the Past"}, {"type": "describer", "content": "You can use modals to talk about degrees of certainty and speculate about things in the past. You use them to describe what is definite, probable, possible, or impossible from the speaker's point of view. "}, {"type": "text", "content": "You can use <span class=\"italic\">must</span>, <span class=\"italic\">may</span>, <span class=\"italic\">might</span>, and <span class=\"italic\">could</span> to describe degrees of certainty.<br/>You can use modals with the Present Perfect to talk about the possibility of a past event that is not clear in the present context."}, {"type": "text", "content": "Example:"}, {"type": "text", "content": "<span class=\"italic\">You <span class=\"strong\">might have dealt</span> with a younger sister. If you have, you <span class=\"strong\">may have had</span> an experience similar to the one I had. </span>"}, {"type": "text", "content": "Look at the chart for the meanings of modals when speculating about the past:"}, {"type": "table", "content": "{\"rows\":3,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Modal Phrase\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Meaning\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Must have\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" It is very likely\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"May have <br/>Might have<br/>Could have\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" It is possible \\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "text", "content": "<ul><li><span class=\"italic\">May have</span> has a slightly stronger meaning than <span class=\"italic\">might have</span> or <span class=\"italic\">could have</span>.</li><li>You can add <span class=\"italic\">not</span> to make a negative speculation (It <span class=\"italic\">may not have been</span> true).</li></ul>"}, {"type": "example", "content": "You might have dealt with a younger sister. "}, {"type": "example", "content": "If you had, you may have had an experience similar to the one I had. "}, {"type": "example", "content": "My sister could have tried anyone's patience at times.  "}, {"type": "example", "content": "She must have asked me a million questions over the years."}, {"type": "example", "content": "I thought I must have heard them all over the years. "}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to deal "}, {"type": "definition", "content": "to cope with a situation which is unpleasant or with someone who behaves unpleasantly "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I have to deal with my sister every morning."}, {"type": "audio", "content": "engenn9le12ob06aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you use to talk about kid sisters."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "startling"}, {"type": "definition", "content": "very surprising or worrying"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Every once in a while, she came up with a startling question. "}, {"type": "audio", "content": "engenn9le12ob06aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "astonishment"}, {"type": "definition", "content": "a great surprise"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: To my astonishment she looked embarrassed down at the table."}, {"type": "audio", "content": "engenn9le12ob06aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "sheepishly"}, {"type": "definition", "content": "done with embarrassment because a person knows they have done something wrong or silly "}, {"type": "part_speech", "content": "(adverb)"}, {"type": "example", "content": "Example: She looked sheepishly down at the table."}, {"type": "audio", "content": "engenn9le12ob06aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "apprehensively"}, {"type": "definition", "content": "done with anxiety, or a fear that something unpleasant will happen "}, {"type": "part_speech", "content": "(adverb)"}, {"type": "example", "content": "Example: She whispered apprehensively."}, {"type": "audio", "content": "engenn9le12ob06aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "speechless"}, {"type": "definition", "content": "unable to speak because of anger, surprise or sadness"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: I was speechless."}, {"type": "audio", "content": "engenn9le12ob06aud06"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Think of ways siblings can be annoying."}, {"type": "text", "content": "On 10 cards write sentences saying what a sibling did. (my younger sister used my new makeup to paint a wall)."}, {"type": "text", "content": "Now use the cards to talk about hypothetical situations in the past. (if my younger sister had ...)"}, {"type": "text", "content": "Take your cards to class and trade with another partner. "}, {"type": "text", "content": "Take turns talking about hypothetical situations in the past with the prompts from the cards."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I write sentence on 10 cards saying what a sibling did."}, {"type": "text", "content": "I practice using the third conditional, say what I would have done in that situation."}, {"type": "text", "content": "I use the third conditional to say what I would have done in situations my partner has written up."}]}]}