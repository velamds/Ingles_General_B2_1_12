 [], "type": "DWS", "questions": [{"responses": [{"correct": 1, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "pdf", "content": "engenn9le12ob01re7pdf01.pdf"}]}]}], "template_override": 1, "id": 10, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " \nWrite about a lost love.\n"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n"}]}]}, {"stimuli_ids": [], "type": "TYP", "questions": [{"responses": [{"correct": 0, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "id": 1, "selected": 0, "_data": [{"type": "text", "content": "has always thought"}]}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "audio", "content": "engenn9le12ob01re5aud01"}, {"type": "text", "content": "Tom"}]}, {"type": "post_question", "contents": {"type": "", "content": "of his childhood friend and girlfriend Susanna as his only true love."}}, {"type": "objective", "content": "secondary_3"}]}, {"responses": [{"correct": 0, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "id": 1, "selected": 0, "_data": [{"type": "text", "content": "looked at him"}]}], "id": 1, "_data": [{"type": "question", "contents": [{"type": "audio", "content": "engenn9le12ob01re5aud02"}, {"type": "text", "content": "She"}]}, {"type": "post_question", "contents": {"type": "", "content": "smiling with strained insincerity."}}, {"type": "objective", "content": "secondary_3"}]}, {"responses": [{"correct": 0, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "id": 1, "selected": 0, "_data": [{"type": "text", "content": "has been writing"}]}], "id": 2, "_data": [{"type": "question", "contents": [{"type": "audio", "content": "engenn9le12ob01re5aud03"}, {"type": "text", "content": "Tom"}]}, {"type": "post_question", "contents": {"type": "", "content": "to her faithfully since she moved away with her parents several years ago."}}, {"type": "objective", "content": "secondary_3"}]}, {"responses": [{"correct": 0, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "id": 1, "selected": 0, "_data": [{"type": "text", "content": "pulled away that day"}]}], "id": 3, "_data": [{"type": "question", "contents": [{"type": "audio", "content": "engenn9le12ob01re5aud04"}, {"type": "text", "content": "Since the moving van "}]}, {"type": "post_question", "contents": {"type": "", "content": ", his life has not been the same. "}}, {"type": "objective", "content": "secondary_3"}]}, {"responses": [{"correct": 0, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "id": 1, "selected": 0, "_data": [{"type": "text", "content": "walked into the room"}]}], "id": 4, "_data": [{"type": "question", "contents": [{"type": "audio", "content": "engenn9le12ob01re5aud05"}, {"type": "text", "content": "As soon as he "}]}, {"type": "post_question", "contents": {"type": "", "content": ", he realized that his Suzanna may have been a fabrication. "}}, {"type": "objective", "content": "secondary_3"}]}, {"responses": [{"correct": 0, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "id": 1, "selected": 0, "_data": [{"type": "text", "content": ""}]}], "id": 5, "_data": [{"type": "question", "contents": [{"type": "rec", "content": ""}]}, {"type": "objective", "content": "secondary_3"}]}], "template_override": 1, "id": 11, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " Tom has missed Susanna since the day she left. \n"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Activity 3"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Listening"}, {"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: <span class=\"bullet\">Listen to the audio.</span> <span class=\"bullet\">Type in the missing words. </span><span class=\"bullet\">Record yourself saying the sentences aloud. </span><span class=\"bullet\">Compare yourself to the audio.</span> "}, {"type": "text", "content": "  You have 2 attempts to submit your answers."}]}]}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn9le12ob01re2img02.jpg", "audiosrc": "engenn9le12ob01re2aud01", "images": [{"time": "0", "image": "engenn9le12ob01re2img02.jpg", "text": "", "id": 0}, {"time": "100", "image": "engenn9le12ob01re2img02.jpg", "text": "Tom has always thought of his childhood friend and girlfriend Susanna as his only true love and confidant. Susanna was the most natural person he ever met. She didn't care about her appearance. She was too busy enjoying the world. <br/><br/>Tom has been writing to her faithfully since she moved away with her parents several years ago. Since the moving van pulled away that day, his life has not been the same.", "id": 1}, {"time": "26000", "image": "engenn9le12ob01re2img03.jpg", "text": "He was sure she must have missed him just as much. Admittedly, she may have avoided replying to a letter here and there. She might have said less and less in them, regrettably.<br/><br/>However, she must have known they were destined to be together just as he did! They may have been divided by distance, but surely she must have felt his love transverse it!<br/><br/>Now, he was going to see Susanna again. She had come to visit her aunt. When he shut his eyes, he could still see her long, red hair and her warm smile.", "id": 2}, {"time": "58000", "image": "engenn9le12ob01re2img01.jpg", "text": "As soon as he walked into the room, he realized that <span class=\"italic\">his</span> Suzanna may have been a fabrication. \u201cShe's completely changed. She has lost her fun-loving smile\u201d, he thought. <br/><br/>She looked at him smiling with strained insincerity. She was dressed elegantly. Her hair was now honey blonde. She gave him a short hug and then stepped back to look at him.<br/><br/>\"Why, William,\" she said. \"You've completely changed. You haven't got any fun left in you! How have you become such a mundane, studious person?\"", "id": 3}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Anecdotes and Personal Stories"}, {"type": "unit_name", "content": "After All These Years"}, {"type": "position", "content": 1}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 12}, {"type": "level", "content": "B2.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": " Describe situations in written and spoken interactions according to social contexts."}, {"type": "secondary_1", "content": "Understands specific information in written texts about the different social and work contexts. "}, {"type": "secondary_2", "content": "Understands specific information in written texts about the different social and work contexts. "}, {"type": "secondary_3", "content": "Understands specific information in written texts about the different social and work contexts. "}, {"type": "secondary_4", "content": "Understands specific information in written texts about the different social and work contexts. "}, {"type": "secondary_5", "content": "Understands specific information in written texts about the different social and work contexts. "}, {"type": "secondary_6", "content": "Understands specific information in written texts about the different social and work contexts. "}, {"type": "secondary_7", "content": "Understands specific information in written texts about the different social and work contexts. "}, {"type": "secondary_8", "content": "Understands specific information in written texts about the different social and work contexts. "}]}, {"type": "background_image", "content": "engenn9le12ob01re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "The Present Perfect Tense vs. The Simple Past Tense"}, {"type": "describer", "content": "You use the Present Perfect tense to talk about a past action or an action that began in the past that is connected to the present in some way. <br/><br/>You use the Simple Past tense to talk about many kinds of past events: short, quickly finished actions, longer situations and repeated events. "}, {"type": "text", "content": "You can use the <span class=\"underline\">Present Perfect tense</span> to talk about experience.<br/>When you use the Present Perfect tense, you think about the past and present together. There is some connection between what happened in the past and now.<br/><br/>For example: <br/><br/><span class=\"italic\">I have learned English.</span> = I learned English in the past and now I can speak English.<br/><span class=\"italic\">He has bought a painting. </span>= He bought the painting in the past and now he has a painting.<br/><br/>It is common to use <span class=\"italic\">for</span> and <span class=\"italic\">since</span> when referring to time periods in the Present Perfect:<br/><br/><ul><li>You use FOR to talk about how long an action has been happening (a week, 2 days, five hours, six years etc.)</li><li>You use SINCE to talk about when the action started (2010, Monday, she was a child)</li></ul><br/><span class=\"italic\"><span class=\"strong\">Since</span> the moving van pulled away that day, his life <span class=\"strong\">has not been</span> the same. </span><br/><br/>Usually, when you use the <span class=\"underline\">Simple Past tense</span>, the time of the finished action is clear from the context or explicitly mentioned in the sentence.<br/><br/>For example:<br/><br/><span class=\"italic\"><span class=\"strong\">Yesterday</span>, I went to the store. <br/>She moved away with her parents <span class=\"strong\">several years ago</span>.</span><br/><br/>It is clear when the action occurred. In this sentence we would not use the Present Perfect. (<span style=\"text-decoration:line-through;\">Yesterday, I have been to the store)."}, {"type": "example", "content": "Tom has always thought of his childhood friend and girlfriend Susanna as his only true love and confidant. "}, {"type": "example", "content": "Susanna was the most natural person he ever met. She didn't care about her appearance. She was too busy enjoying the world."}, {"type": "example", "content": "She moved away with her parents several years ago."}, {"type": "example", "content": "Since the moving van pulled away that day, his life has not been the same. "}, {"type": "example", "content": "\u201cShe's completely changed. She has lost her fun-loving smile\u201d. "}, {"type": "example", "content": "She looked at him smiling with strained insincerity. She was dressed elegantly. "}, {"type": "example", "content": "She gave him a short hug and then stepped back to look at him."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Speculating About the Past"}, {"type": "describer", "content": "You can use modals to talk about degrees of certainty and speculate about things in the past.<br/>You use them to describe what is definite, probable, possible, or impossible from the speaker's point of view. "}, {"type": "text", "content": "You can use <span class=\"italic\">must</span>, <span class=\"italic\">may</span>, <span class=\"italic\">might</span>, and <span class=\"italic\">could</span> to describe degrees of certainty.<br/>You can use modals with the Present Perfect to talk about the possibility of a past event that is not clear in the present context."}, {"type": "text", "content": "Example:"}, {"type": "text", "content": "<span class=\"italic\">She <span class=\"strong\">must have known</span> they were destined to be together just as he did! </span>"}, {"type": "text", "content": "Look at the chart for the meanings of modals when speculating about the past:"}, {"type": "table", "content": "{\"rows\":3,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Modal Phrase\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Meaning\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Must have\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" It is very likely\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"May have<br/>Might have<br/>Could have\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" It is possible \\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "text", "content": "<ul><li><span class=\"italic\">May have</span> has a slightly stronger meaning than <span class=\"italic\">might have</span> or <span class=\"italic\">could have</span>.</li><li>You can add <span class=\"italic\">not</span> to make a negative speculation (It <span class=\"italic\">may not have been</span> true).</li></ul>"}, {"type": "example", "content": "He was sure she must have missed him just as much."}, {"type": "example", "content": "Admittedly, she may have avoided replying to a letter here and there. "}, {"type": "example", "content": "She might have said less and less in them, regrettably. "}, {"type": "example", "content": "However, she must have known they were destined to be together just as he did! They may have been divided by distance, but surely she must have felt his love transverse it!"}, {"type": "example", "content": "As soon as he walked into the room, he realized that his Suzanna may have been fabrication. "}]}, {"type": "target_word", "contents": [{"type": "name", "content": "admittedly"}, {"type": "definition", "content": "used when someone agrees that something is true, although they don't want to"}, {"type": "part_speech", "content": "(adverb)"}, {"type": "example", "content": "Example: Admittedly, she may have avoided replying to a letter here and there."}, {"type": "audio", "content": "engenn9le12ob01aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you use to talk about a childhood sweetheart."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "regrettably"}, {"type": "definition", "content": "expressing apology for or sadness at something"}, {"type": "part_speech", "content": "(adverb)"}, {"type": "example", "content": "Example: She might have said less and less in them, regrettably."}, {"type": "audio", "content": "engenn9le12ob01aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "destined"}, {"type": "definition", "content": " controlled by \u200bfate; something which is meant to happen"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: They were destined to be together just as he did!"}, {"type": "audio", "content": "engenn9le12ob01aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to transverse"}, {"type": "definition", "content": "to move across"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: She must have felt his love transverse it!"}, {"type": "audio", "content": "engenn9le12ob01aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "fun-loving"}, {"type": "definition", "content": " used to describe a person who enjoys engaging in activities which are enjoyable, amusing and entertaining"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: She has lost her fun-loving smile."}, {"type": "audio", "content": "engenn9le12ob01aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "fabrication"}, {"type": "definition", "content": "a deceptive creation "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: He realized that his Suzanna may have been fabrication."}, {"type": "audio", "content": "engenn9le12ob01aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "insincerity"}, {"type": "definition", "content": "the feeling of pretending to \u200bfeel something that you do not really \u200bfeel, or not \u200bmeaning what you say"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: She looked at him smiling with strained insincerity."}, {"type": "audio", "content": "engenn9le12ob01aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "mundane"}, {"type": "definition", "content": "very ordinary; not interesting"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: How have you become such a mundane person?"}, {"type": "audio", "content": "engenn9le12ob01aud08"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "studious"}, {"type": "definition", "content": "focused on studying and paying attention to small details"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Why have you become such a studious person?"}, {"type": "audio", "content": "engenn9le12ob01aud09"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Think of someone or imagine that you knew and liked when you were younger and that moved away."}, {"type": "text", "content": "How might things have been if they had stayed in your city?"}, {"type": "text", "content": "How could your relationship have grown (or not)?"}, {"type": "text", "content": "Where could you and this person be today?"}, {"type": "text", "content": "Write a story talking about experiences that you have or haven't had."}, {"type": "text", "content": "Speculate about the past."}, {"type": "text", "content": "Read your story to a partner."}, {"type": "text", "content": "Check together for spelling and grammar mistakes."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I write about someone I knew who moved away."}, {"type": "text", "content": "I use the modal perfect to speculate on what might have happened."}, {"type": "text", "content": "I talk about experiences using the Past Simple and the Present Perfect tenses."}, {"type": "text", "content": "I share my story with a partner then check for spelling and grammar mistakes."}]}]}